  <id>App</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>

  <fileSets>
    <fileSet>
      <directory>${symbol_dollar}{project.basedir}/src/test/resources/apps/fourEyes</directory>
      <useDefaultExcludes>true</useDefaultExcludes>
      <outputDirectory>${symbol_dollar}{file.separator}</outputDirectory>                
    </fileSet>
  </fileSets>

</assembly> 